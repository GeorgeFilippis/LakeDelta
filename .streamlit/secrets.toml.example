# Copy to .streamlit/secrets.toml (never commit the real file) or paste into the
# Secrets box of your Streamlit Community Cloud app. This is the same table the
# first version of LakeDelta read, so existing deployments need no change.

[earth_engine]
type = "service_account"
project_id = "your-ee-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "lakedelta@your-ee-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
